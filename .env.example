# Integración interna de Notion (Debe estar invitada a la base de datos)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx

# ID de la base de datos de Notion (Se encuentra en la URL)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx

# API v2 Token de Gumroad (Settings -> Advanced)
GUMROAD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxx

# API Key de Postly
POSTLY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
POSTLY_WORKSPACE_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
# Preferred: identifier:id pairs. Legacy ID-only entries are supported for known GPT Chain accounts.
POSTLY_TARGET_PLATFORMS=instagram:id1,facebook:id2

# Puerto del servidor (Opcional, por defecto 3000)
PORT=3000

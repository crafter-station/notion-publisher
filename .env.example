# notion-publisher — environment template
# Copy to `.env` and fill secrets. Never commit `.env`.
#
# Required to boot the HTTP server: NOTION_TOKEN, GUMROAD_TOKEN, POSTLY_*, WEBHOOK_TOKEN
# Everything else is optional until you enable that surface.
# migrate-content-os dry-run / --offline needs none of these. --live needs NOTION_TOKEN only.
# Optional: --exclude-ids=<comma list or file> and --exclude-urls=<comma list or file>.

# ─── Notion CMS (required) ─────────────────────────────────────────
# Integration must be invited to the Publisher database.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
# Unified Publisher DB — also used by Postly queue + Gumroad autopilot when those IDs are unset.
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx
# Optional Notion API version override (code default: 2022-06-28)
# NOTION_VERSION=2022-06-28

# ─── Content OS (optional overrides · defaults are the live DBs) ───
# Database ids below are defaults in src/config/schema.ts. Override only if needed.
# NOTION_CANALES_DATABASE_ID=2d899274cb8a4efdb299c70dfa3184e9
# NOTION_CUENTAS_DATABASE_ID=3d2b898f61d7481087452508051c60a4
# NOTION_PIEZAS_DATABASE_ID=0733dfa0b7fa430d8a8fb4b97693ea17
# NOTION_PUBLICACIONES_DATABASE_ID=7ba3eb3574794182ab3628c4d708fca0
# NOTION_PRODUCTOS_DATABASE_ID=c753239a6ce24175a3d198a3d24bbfe5
# NOTION_CONTENT_OS_PARENT_PAGE_ID=404da2435b4681eebbe6c73f68060bdd
# Direct parent is still the Content OS page above. Workspaces data source
# e28e7216-8dc3-4a77-a7ef-e81606bf39c8 is the ancestor collection, not a DB id.
# Must be the string "true" to open the live gate (still needs Activa + Modo live + canal live).
# CONTENT_OS_PUBLISH_LIVE=false
# NOTION_PUBLICACION_READY_STATUSES=Pendiente,Dry-run OK,En cola

# ─── Gumroad products (required to boot) ───────────────────────────
# API v2 token: Gumroad Settings → Advanced
GUMROAD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxx
# Must be true AND resolveLiveGate live to publish. Default stays dry-run.
# GUMROAD_PUBLISH_LIVE=false

# ─── Postly social (required to boot) ──────────────────────────────
POSTLY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
POSTLY_WORKSPACE_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
# Preferred: identifier:id pairs. Legacy ID-only entries still work for known accounts.
POSTLY_TARGET_PLATFORMS=instagram:id1,facebook:id2
# Optional. Future opt-in audience_group id. Unused by default publish path.
# POSTLY_AUDIENCE_GROUP=
# Must be true AND resolveLiveGate live to call Postly. Default stays dry-run.
# POSTLY_PUBLISH_LIVE=false

# ─── Luma events (optional · live) ─────────────────────────────────
# Calendar API key: Luma Plus → Settings → Developer
# Enables POST /webhooks/publish-luma
# LUMA_API_KEY=secret-xxxxxxxxxxxx
# Must be true AND resolveLiveGate live to create an event. Default stays dry-run.
# LUMA_PUBLISH_LIVE=false

# ─── GitHub products (optional · live · TheVeller only) ────────────
# Fine-grained or classic PAT. Scopes: list repos (catalog) + contents/releases on TheVeller.
# Enables catalog import, GET /capabilities/github, POST /webhooks/publish-github
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Must be true AND resolveLiveGate live to create a Release. Default stays dry-run.
# GITHUB_PUBLISH_LIVE=false

# ─── Skool / MySkool (optional · discover) ─────────────────────────
# Mint sk_live_… at https://myskool.xyz — enables GET /capabilities/skool
# Write webhook still blocked upstream (#4).
# SKOOL_API_KEY=sk_live_xxxxxxxxxxxx
# Optional default group id for capabilities sample posts
# SKOOL_GROUP_ID=

# ─── Composio (optional · Reddit + Eventbrite · dry-run default) ───
# Source Tag Composio — Reddit + Eventbrite via POST /webhooks/publish-composio.
# Dry-run builds the exact /tools/execute payload. Live needs COMPOSIO_PUBLISH_LIVE=true
# and a connected Eventbrite account in the Composio dashboard (no paid plan assumed).
# COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=              # from GET /capabilities/composio → accounts[].user_id
# COMPOSIO_CONNECTED_ACCOUNT_ID= # reddit.accounts[].id
# COMPOSIO_REDDIT_SUBREDDIT=test # fallback if Notion Reddit Subreddit empty
# COMPOSIO_EVENTBRITE_ORGANIZATION_ID=
# COMPOSIO_EVENTBRITE_CONNECTED_ACCOUNT_ID=
# COMPOSIO_EVENTBRITE_CURRENCY=USD
# COMPOSIO_EVENTBRITE_TOOLKIT_VERSION=20260724_00
# COMPOSIO_PUBLISH_LIVE=false

# ─── Postiz (optional · live · dry-run default) ────────────────────
# Public API: https://docs.postiz.com/public-api
# Prefer self-hosted. Do not assume a paid Postiz Cloud plan.
# POSTIZ_API_KEY=
# POSTIZ_API_BASE=https://your-postiz.example/api/public/v1
# identifier:id pairs for wired channels (Discord Slack Mastodon Skool Twitch Kick Warpcast Nostr Lemmy Listmonk)
# POSTIZ_INTEGRATIONS=discord:id,slack:id,mastodon:id
# Optional per-channel settings fallbacks
# POSTIZ_DISCORD_CHANNEL=
# POSTIZ_SLACK_CHANNEL=
# POSTIZ_SKOOL_GROUP=
# POSTIZ_SKOOL_LABEL=
# POSTIZ_LISTMONK_LIST=
# Must be true AND webhook ?live=true to call POST /posts. Default stays dry-run.
# POSTIZ_PUBLISH_LIVE=false

# ─── Typefully (optional · live · dry-run default) ─────────────────
# Public API v2: https://typefully.com/docs/api
# Authorization: Bearer $TYPEFULLY_API_KEY
# TYPEFULLY_API_KEY=
# TYPEFULLY_SOCIAL_SET_ID=       # from GET /v2/social-sets (or Notion Typefully Account)
# Must be true AND webhook ?live=true to POST a draft. Never sends publish_at.
# TYPEFULLY_PUBLISH_LIVE=false

# ─── Restream (optional · create/schedule · dry-run only) ──────────
# Official Events API: POST https://api.restream.io/v2/user/events/new
# OAuth2 Bearer token. Create or schedule only — never go-live. StreamYard excluded.
# Dry-run works without a token. Live create is disabled in this connector.
# RESTREAM_ACCESS_TOKEN=
# RESTREAM_CLIENT_ID=
# RESTREAM_CLIENT_SECRET=
# RESTREAM_REFRESH_TOKEN=

# ─── Other stubs (optional · not wired) ────────────────────────────
# ONCE_API_KEY=                 # Music / podcast DSP

# ─── Postly queue (optional automation) ────────────────────────────
# Off by default. Even when enabled, the queue stays dry-run unless
# resolveLiveGate is live AND POSTLY_PUBLISH_LIVE=true.
# Use the same DB id as NOTION_DATABASE_ID unless you intentionally split.
POSTLY_QUEUE_ENABLED=false
POSTLY_QUEUE_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx
POSTLY_QUEUE_INTERVAL_MS=21600000
POSTLY_QUEUE_RUN_ON_START=false
POSTLY_QUEUE_BLOCK_ON_PENDING_POSTS=true
POSTLY_QUEUE_PENDING_BLOCK_WINDOW_MS=21600000

# ─── Gumroad autopilot (optional automation) ───────────────────────
# Same Publisher DB; filters via Source Tags / Layer.
GUMROAD_AUTOPILOT_ENABLED=false
GUMROAD_AUTOPILOT_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx
GUMROAD_AUTOPILOT_INTERVAL_MS=8640000
GUMROAD_AUTOPILOT_RUN_ON_START=false
GUMROAD_AUTOPILOT_DAILY_LIMIT=10
GUMROAD_AUTOPILOT_TIMEZONE=America/Lima
GUMROAD_AUTOPILOT_PUBLISH_LIVE=false

# ─── Server ────────────────────────────────────────────────────────
PORT=3000
# Required to boot the HTTP server. At least 32 characters.
# Authorization: Bearer $WEBHOOK_TOKEN on every /webhooks/* request.
WEBHOOK_TOKEN=

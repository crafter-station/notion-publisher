{
  "name": "notion-publisher",
  "version": "1.0.0",
  "description": "Notion CMS orchestrator — products, social, events, music/podcast publish channels",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "capabilities:check": "ts-node --transpile-only src/capabilities/registry.selfcheck.ts",
    "composio:ensure-props": "ts-node --transpile-only scripts/ensure-composio-notion-props.ts",
    "composio:check-extract": "ts-node --transpile-only scripts/check-composio-extract.ts",
    "composio:smoke": "ts-node --transpile-only scripts/smoke-composio-reddit.ts",
    "luma:import-tnc": "ts-node --transpile-only scripts/import-luma-tnc-aug29.ts",
    "to-cms": "ts-node --transpile-only scripts/to-cms.ts",
    "notion:schema": "ts-node --transpile-only scripts/notion-schema.ts",
    "github:import-repos": "ts-node --transpile-only scripts/import-github-repos.ts",
    "publisher:report": "node scripts/generate-publisher-daily-report.mjs",
    "publisher:commit": "bash scripts/daily-publisher-commit.sh"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.14",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
